# ============================================================
# City AI Agent - Environment Configuration Template
# ============================================================
# Copy this file to '.env' and fill in your API keys before running.

# ------------------------------------------------------------
# 1. Google Gemini API Key (Primary LLM & Fallback 1)
# Used for gemini-3.6-flash and gemini-3.1-flash
# Get your key at: https://aistudio.google.com/
# ------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here

# ------------------------------------------------------------
# 2. Mistral AI API Key (Fallback 2)
# Used for mistral-small-latest
# Get your key at: https://console.mistral.ai/
# ------------------------------------------------------------
MISTRAL_API_KEY=your_mistral_api_key_here

# ------------------------------------------------------------
# 3. OpenAI API Key (Fallback 3)
# Used for gpt-5-mini
# Get your key at: https://platform.openai.com/api-keys
# ------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------
# 4. OpenWeatherMap API Key (Weather Tool)
# Used to fetch real-time weather metrics for cities in India
# Get your free key at: https://home.openweathermap.org/api_keys
# ------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------
# 5. Tavily Search API Key (News Tool)
# Used for real-time web search and latest news retrieval
# Get your free key at: https://app.tavily.com/
# ------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
